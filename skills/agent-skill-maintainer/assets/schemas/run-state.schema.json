{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiewxin.github.io/agent-skill-maintainer/schemas/run-state.schema.json",
  "title": "Maintainer Run State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "binding_id", "phase", "status", "approvals", "consumed_approval_fingerprints"],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "run_id": {"type": "string", "minLength": 1},
    "binding_id": {"type": "string", "minLength": 1},
    "phase": {
      "type": "string",
      "enum": ["target_selection", "evidence_collection", "feedback_validation", "optimization_design", "optimization_approval", "isolation", "implementation", "validation", "pr_creation", "pr_update", "merge", "release", "local_update", "completed", "aborted", "blocked"]
    },
    "status": {"type": "string", "enum": ["active", "completed", "aborted", "blocked"]},
    "target": {"type": "object"},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "feedback_ids": {"type": "array", "items": {"type": "string"}},
    "optimization_ids": {"type": "array", "items": {"type": "string"}},
    "approvals": {"type": "array", "items": {"type": "object"}},
    "consumed_approval_fingerprints": {
      "type": "array",
      "items": {"type": "string", "pattern": "[a-f0-9]{64}"}
    },
    "action_preview": {"type": "object"},
    "repository_snapshot": {"type": "object"},
    "candidate_snapshot": {"type": "object"},
    "validation_summary": {"type": "object"},
    "pr_proof": {"type": "object"},
    "merge_proof": {"type": "object"},
    "publication_proof": {"type": "object"},
    "release_version": {"type": "string", "minLength": 1},
    "release_coverage": {"type": "object"},
    "update_proof": {"type": "object"}
  }
}
