{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiewxin.github.io/agent-skill-maintainer/schemas/run-state.schema.json",
  "title": "Maintainer Run State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "binding_id", "phase", "status", "approvals", "consumed_approval_fingerprints", "attempted_github_action_fingerprints", "github_action_attempts", "github_action_reconciliations", "attempted_local_update_fingerprints", "local_update_attempts", "local_update_reconciliations"],
  "properties": {
    "schema_version": {"type": "integer", "const": 8},
    "run_id": {"type": "string", "minLength": 1},
    "binding_id": {"type": "string", "minLength": 1},
    "phase": {
      "type": "string",
      "enum": ["target_selection", "evidence_collection", "feedback_validation", "optimization_design", "optimization_approval", "isolation", "implementation", "validation", "fork_creation", "branch_push", "publish_pr", "pr_creation", "pr_update", "merge", "release", "local_update", "completed", "aborted", "blocked"]
    },
    "status": {"type": "string", "enum": ["active", "completed", "aborted", "blocked"]},
    "target": {"type": "object"},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "feedback_ids": {"type": "array", "items": {"type": "string"}},
    "optimization_ids": {"type": "array", "items": {"type": "string"}},
    "approvals": {"type": "array", "items": {"type": "object"}},
    "consumed_approval_fingerprints": {
      "type": "array",
      "items": {"type": "string", "pattern": "[a-f0-9]{64}"}
    },
    "attempted_github_action_fingerprints": {
      "type": "array",
      "items": {"type": "string", "pattern": "[a-f0-9]{64}"}
    },
    "github_action_attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "approval_fingerprint"],
        "properties": {
          "action": {"type": "string", "enum": ["fork_create", "branch_push", "publish_pr", "pr_create", "pr_update", "merge", "release", "unknown"]},
          "approval_fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"},
          "attempted_at": {"type": "string", "format": "date-time"},
          "preview_fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"},
          "repository": {"type": "string", "minLength": 1},
          "fork_repository": {"type": "string", "minLength": 1}
        }
      }
    },
    "github_action_reconciliations": {
      "type": "array",
      "items": {"type": "object"}
    },
    "attempted_local_update_fingerprints": {
      "type": "array",
      "items": {"type": "string", "pattern": "[a-f0-9]{64}"}
    },
    "local_update_attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["approval_fingerprint", "preview_fingerprint", "attempted_at", "canonical_path_fingerprint"],
        "properties": {
          "approval_fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"},
          "preview_fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"},
          "attempted_at": {"type": "string", "minLength": 1},
          "canonical_path_fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"}
        }
      }
    },
    "local_update_reconciliations": {
      "type": "array",
      "items": {"type": "object"}
    },
    "action_preview": {"type": "object"},
    "repository_snapshot": {"type": "object"},
    "candidate_snapshot": {"type": "object"},
    "validation_summary": {"type": "object"},
    "fork_proof": {"type": "object"},
    "branch_push_proof": {"type": "object"},
    "pr_proof": {"type": "object"},
    "merge_proof": {"type": "object"},
    "publication_proof": {"type": "object"},
    "release_version": {"type": "string", "minLength": 1},
    "release_coverage": {"type": "object"},
    "update_proof": {"type": "object"},
    "completion_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "after_phase", "reason"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "kind": {
          "type": "string",
          "enum": ["no_improvements", "stop_after_pr", "stop_after_merge", "stop_after_release", "local_update_verified", "legacy_completed"]
        },
        "after_phase": {
          "type": "string",
          "enum": ["optimization_design", "publish_pr", "pr_creation", "pr_update", "merge", "release", "local_update", "unknown"]
        },
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "source_run_id", "source_state_fingerprint", "merge_proof_fingerprint"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "source_run_id": {"type": "string", "minLength": 1},
        "source_state_fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"},
        "merge_proof_fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"}
      }
    }
  }
}
