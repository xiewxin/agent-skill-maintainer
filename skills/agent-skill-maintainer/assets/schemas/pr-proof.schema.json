{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiewxin.github.io/agent-skill-maintainer/schemas/pr-proof.schema.json",
  "title": "Pull Request Proof",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "number", "head_commit", "base_branch", "state", "checks_passed", "documentation_impact"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "repository": {"type": "string", "minLength": 1},
    "number": {"type": "integer"},
    "head_commit": {"type": "string", "minLength": 1},
    "base_branch": {"type": "string", "minLength": 1},
    "state": {"type": "string", "enum": ["open", "closed", "merged"]},
    "checks_passed": {"type": "boolean"},
    "documentation_impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "changed_guides", "root_index_action", "contract_preserved", "reason"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "status": {"type": "string", "enum": ["updated", "not-required", "upstream-follow-up"]},
        "changed_guides": {"type": "array", "items": {"type": "string"}},
        "root_index_action": {"type": "string", "enum": ["updated", "verified-current", "not-applicable", "upstream-follow-up"]},
        "contract_preserved": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
