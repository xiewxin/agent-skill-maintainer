{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiewxin.github.io/agent-skill-maintainer/schemas/github-action-approval.schema.json",
  "title": "GitHub Action Confirmation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action", "preview_fingerprint", "run_id", "binding_id", "account", "repository", "relationship", "base_branch", "head_branch", "head_commit", "diff_hash", "action_target_hash", "release_enabled", "provider_contract_hash", "confirmed_at", "expires_at", "fingerprint"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "action": {"type": "string", "enum": ["pr_create", "pr_update", "merge", "release", "local_update"]},
    "preview_fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"},
    "run_id": {"type": "string", "minLength": 1},
    "binding_id": {"type": "string", "minLength": 1},
    "account": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "relationship": {"type": "string", "enum": ["managed", "contribute"]},
    "base_branch": {"type": "string", "minLength": 1},
    "head_branch": {"type": "string", "minLength": 1},
    "head_commit": {"type": "string", "minLength": 1},
    "diff_hash": {"type": "string", "minLength": 1},
    "action_target_hash": {"type": "string", "pattern": "[a-f0-9]{64}"},
    "release_enabled": {"type": "boolean"},
    "provider_contract_hash": {"type": "string", "minLength": 1},
    "confirmed_at": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "minLength": 1},
    "fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"}
  }
}
