{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiewxin.github.io/agent-skill-maintainer/schemas/provider-profile.schema.json",
  "title": "Workflow Provider Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_schema_version", "provider_id", "role_type", "version_detection", "tested_versions", "last_verified_at", "verification_evidence", "supported_platforms", "capabilities", "artifact_contracts", "command_policy", "fallback", "blocking"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "profile_schema_version": {"type": "integer", "const": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "role_type": {"type": "string", "enum": ["formal", "auxiliary"]},
    "version_detection": {"type": "object"},
    "tested_versions": {"type": "array", "items": {"type": "string"}},
    "last_verified_at": {"type": ["string", "null"]},
    "verification_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "repository", "repository_status", "release_url", "scope", "artifacts"],
        "properties": {
          "version": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "repository_status": {"type": "string", "enum": ["active", "archived"]},
          "release_url": {"type": "string", "pattern": "https://github\\.com/.+"},
          "scope": {"type": "string", "enum": ["artifact-contract-read-only", "commands"]},
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "supported_platforms": {"type": "array", "items": {"type": "string"}},
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "artifact_contracts": {"type": "array", "items": {"type": "object"}},
    "command_policy": {"type": "object"},
    "fallback": {"type": "object"},
    "blocking": {"type": "object"},
    "unsupported_versions": {"type": "array", "items": {"type": "string"}}
  }
}
