{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiewxin.github.io/agent-skill-maintainer/schemas/blinded-forward-aggregate.schema.json",
  "title": "Derived Blinded Forward Evaluation Aggregate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_kind",
    "evaluated_at",
    "fixture",
    "candidate_skill_fingerprint",
    "raw_outputs_published",
    "evidence_sources",
    "protocol",
    "forward_evaluation",
    "cost",
    "platform_validation",
    "limits"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 5},
    "evidence_kind": {"type": "string", "const": "blinded-forward-aggregate"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "fixture": {"type": "string", "minLength": 1},
    "candidate_skill_fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"},
    "raw_outputs_published": {"type": "boolean", "const": false},
    "evidence_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adjudication_sha256", "measurement_sha256", "platform_validation_sha256", "private_source_manifest_sha256"],
      "properties": {
        "adjudication_sha256": {"type": "string", "pattern": "[a-f0-9]{64}"},
        "measurement_sha256": {"type": "string", "pattern": "[a-f0-9]{64}"},
        "platform_validation_sha256": {"type": "string", "pattern": "[a-f0-9]{64}"},
        "private_source_manifest_sha256": {"type": "string", "pattern": "[a-f0-9]{64}"}
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_status",
        "held_out_from_iteration",
        "rubric_locked_before_outputs",
        "randomized_assignment",
        "independent_judge",
        "verdicts_recorded_before_unblind",
        "same_model_and_tools",
        "model_id",
        "judge_model_id",
        "locked_at",
        "assignment_committed_at",
        "evaluation_input_sha256",
        "baseline_started_at",
        "candidate_started_at",
        "judging_completed_at",
        "unblinded_at",
        "prompt_sha256",
        "artifacts_sha256",
        "rubric_sha256",
        "tool_profile_sha256",
        "baseline_session_sha256",
        "candidate_session_sha256",
        "judge_session_sha256"
      ],
      "properties": {
        "fixture_status": {"type": "string", "const": "held-out"},
        "held_out_from_iteration": {"type": "boolean", "const": true},
        "rubric_locked_before_outputs": {"type": "boolean", "const": true},
        "randomized_assignment": {"type": "boolean", "const": true},
        "independent_judge": {"type": "boolean", "const": true},
        "verdicts_recorded_before_unblind": {"type": "boolean", "const": true},
        "same_model_and_tools": {"type": "boolean", "const": true},
        "model_id": {"type": "string", "minLength": 1},
        "judge_model_id": {"type": "string", "minLength": 1},
        "locked_at": {"type": "string", "format": "date-time"},
        "assignment_committed_at": {"type": "string", "format": "date-time"},
        "evaluation_input_sha256": {"type": "string", "pattern": "[a-f0-9]{64}"},
        "baseline_started_at": {"type": "string", "format": "date-time"},
        "candidate_started_at": {"type": "string", "format": "date-time"},
        "judging_completed_at": {"type": "string", "format": "date-time"},
        "unblinded_at": {"type": "string", "format": "date-time"},
        "prompt_sha256": {"type": "string", "pattern": "[a-f0-9]{64}"},
        "artifacts_sha256": {"type": "string", "pattern": "[a-f0-9]{64}"},
        "rubric_sha256": {"type": "string", "pattern": "[a-f0-9]{64}"},
        "tool_profile_sha256": {"type": "string", "pattern": "[a-f0-9]{64}"},
        "baseline_session_sha256": {"type": "string", "pattern": "[a-f0-9]{64}"},
        "candidate_session_sha256": {"type": "string", "pattern": "[a-f0-9]{64}"},
        "judge_session_sha256": {"type": "string", "pattern": "[a-f0-9]{64}"}
      }
    },
    "forward_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_findings_hidden",
        "required_behaviors",
        "baseline_passed_behaviors",
        "candidate_passed_behaviors",
        "candidate_regressions",
        "false_positive_optimizations",
        "passed"
      ],
      "properties": {
        "expected_findings_hidden": {"type": "boolean", "const": true},
        "required_behaviors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "baseline_verdict",
              "candidate_verdict",
              "baseline_evidence_sha256",
              "candidate_evidence_sha256"
            ],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "baseline_verdict": {
                "type": "string",
                "enum": ["pass", "fail", "insufficient_evidence"]
              },
              "candidate_verdict": {
                "type": "string",
                "enum": ["pass", "fail", "insufficient_evidence"]
              },
              "baseline_evidence_sha256": {"type": "string", "pattern": "[a-f0-9]{64}"},
              "candidate_evidence_sha256": {"type": "string", "pattern": "[a-f0-9]{64}"}
            }
          }
        },
        "baseline_passed_behaviors": {"type": "integer", "minimum": 0},
        "candidate_passed_behaviors": {"type": "integer", "minimum": 0},
        "candidate_regressions": {"type": "integer", "minimum": 0},
        "false_positive_optimizations": {"type": "integer", "minimum": 0},
        "passed": {"type": "boolean"}
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_artifact_bytes",
        "candidate_artifact_bytes",
        "artifact_byte_ratio",
        "baseline_tool_calls",
        "candidate_tool_calls",
        "candidate_heading_count",
        "passed"
      ],
      "properties": {
        "baseline_artifact_bytes": {"type": "integer", "minimum": 1},
        "candidate_artifact_bytes": {"type": "integer", "minimum": 1},
        "artifact_byte_ratio": {"type": "number", "minimum": 0},
        "baseline_tool_calls": {"type": "integer", "minimum": 0},
        "candidate_tool_calls": {"type": "integer", "minimum": 0},
        "candidate_heading_count": {"type": "integer", "minimum": 0},
        "passed": {"type": "boolean"}
      }
    },
    "platform_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_skill_fingerprint",
        "validated_at",
        "installer",
        "installed_copies",
        "platforms",
        "passed"
      ],
      "properties": {
        "candidate_skill_fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"},
        "validated_at": {"type": "string", "format": "date-time"},
        "installer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "scope"],
          "properties": {
            "name": {"type": "string", "const": "skills"},
            "version": {"type": "string", "minLength": 1},
            "scope": {"type": "string", "const": "isolated-project-copy"}
          }
        },
        "installed_copies": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platform", "tree_fingerprint", "file_count"],
            "properties": {
              "platform": {"type": "string", "enum": ["codex", "claude-code"]},
              "case": {"type": "string", "enum": ["positive", "negative"]},
              "installation_relative_path": {"type": "string", "enum": [".agents/skills/agent-skill-maintainer", ".claude/skills/agent-skill-maintainer"]},
              "tree_fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"},
              "file_count": {"type": "integer", "minimum": 1}
            }
          }
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "explicit_trigger",
              "target_and_reference_read",
              "positive_analysis",
              "negative_non_trigger",
              "stable_ids",
              "decision_boundary",
              "files_modified",
              "positive_output_sha256",
              "positive_transcript_sha256",
              "negative_output_sha256",
              "negative_transcript_sha256",
              "passed"
            ],
            "properties": {
              "id": {"type": "string", "enum": ["codex", "claude-code"]},
              "version": {"type": "string", "minLength": 1},
              "explicit_trigger": {"type": "boolean"},
              "target_and_reference_read": {"type": "boolean"},
              "positive_analysis": {"type": "boolean"},
              "negative_non_trigger": {"type": "boolean"},
              "stable_ids": {"type": "boolean"},
              "decision_boundary": {"type": "boolean"},
              "files_modified": {"type": "boolean"},
              "positive_output_sha256": {"type": "string", "pattern": "[a-f0-9]{64}"},
              "positive_transcript_sha256": {"type": "string", "pattern": "[a-f0-9]{64}"},
              "negative_output_sha256": {"type": "string", "pattern": "[a-f0-9]{64}"},
              "negative_transcript_sha256": {"type": "string", "pattern": "[a-f0-9]{64}"},
              "passed": {"type": "boolean"}
            }
          }
        },
        "passed": {"type": "boolean"}
      }
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
