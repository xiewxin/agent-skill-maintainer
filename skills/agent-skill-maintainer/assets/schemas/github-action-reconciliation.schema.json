{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiewxin.github.io/agent-skill-maintainer/schemas/github-action-reconciliation.schema.json",
  "title": "GitHub Action Reconciliation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action",
    "repository",
    "approval_fingerprint",
    "preview_fingerprint",
    "observed_at",
    "status",
    "remote_state_hash"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "action": {"type": "string", "enum": ["fork_create", "branch_push", "publish_pr", "pr_create", "pr_update", "merge", "release"]},
    "repository": {"type": "string", "minLength": 1},
    "approval_fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"},
    "preview_fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"},
    "observed_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["not_applied", "partial", "pending", "blocked", "drifted"]},
    "remote_state_hash": {"type": "string", "pattern": "[a-f0-9]{64}"}
  }
}
