{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiewxin.github.io/agent-skill-maintainer/schemas/update-proof.schema.json",
  "title": "Local Skill Update Proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "binding_id",
    "skill",
    "repository",
    "from_version",
    "to_version",
    "release_tag",
    "source_commit",
    "install_method",
    "scope",
    "mode",
    "canonical_path_fingerprint",
    "previous_fingerprint",
    "installed_fingerprint",
    "lock_entry_hash",
    "agent_links_hash",
    "operation",
    "activation",
    "verified_at",
    "verified"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "run_id": {"type": "string", "minLength": 1},
    "binding_id": {"type": "string", "minLength": 1},
    "skill": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "from_version": {"type": ["string", "null"]},
    "to_version": {"type": "string", "minLength": 1},
    "release_tag": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "[a-f0-9]{40}"},
    "install_method": {"type": "string", "const": "npx-skills"},
    "scope": {"type": "string", "const": "global"},
    "mode": {"type": "string", "const": "symlink"},
    "canonical_path_fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"},
    "previous_fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"},
    "installed_fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"},
    "lock_entry_hash": {"type": "string", "pattern": "[a-f0-9]{64}"},
    "agent_links_hash": {"type": "string", "pattern": "[a-f0-9]{64}"},
    "operation": {"type": "string", "enum": ["update", "already_applied"]},
    "activation": {"type": "string", "const": "future_tasks_only"},
    "verified_at": {"type": "string", "minLength": 1},
    "verified": {"type": "boolean"}
  }
}
