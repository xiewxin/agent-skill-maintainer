{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiewxin.github.io/agent-skill-maintainer/schemas/local-update-preview.schema.json",
  "title": "Local Skill Update Preview",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action", "state", "fingerprint"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "action": {"type": "string", "const": "local_update"},
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "binding_id",
        "skill",
        "repository",
        "relationship",
        "from_version",
        "to_version",
        "release_tag",
        "source_commit",
        "install_method",
        "scope",
        "mode",
        "source_url",
        "skill_path",
        "agents",
        "lock_schema_version",
        "canonical_path_fingerprint",
        "current_fingerprint",
        "target_tree_sha",
        "current_ref",
        "target_ref",
        "lock_entry_hash",
        "agent_links_hash",
        "provider_contract_hash"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "binding_id": {"type": "string", "minLength": 1},
        "skill": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "relationship": {"type": "string", "enum": ["managed", "contribute"]},
        "from_version": {"type": ["string", "null"]},
        "to_version": {"type": "string", "minLength": 1},
        "release_tag": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "pattern": "[a-f0-9]{40}"},
        "install_method": {"type": "string", "const": "npx-skills"},
        "scope": {"type": "string", "const": "global"},
        "mode": {"type": "string", "const": "symlink"},
        "source_url": {"type": "string", "minLength": 1},
        "skill_path": {"type": "string", "minLength": 1},
        "agents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["codex", "claude-code"]}
        },
        "lock_schema_version": {"type": "integer", "const": 3},
        "canonical_path_fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"},
        "current_fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"},
        "target_tree_sha": {"type": "string", "pattern": "[a-f0-9]{40}"},
        "current_ref": {"type": ["string", "null"]},
        "target_ref": {"type": "string", "minLength": 1},
        "lock_entry_hash": {"type": "string", "pattern": "[a-f0-9]{64}"},
        "agent_links_hash": {"type": "string", "pattern": "[a-f0-9]{64}"},
        "provider_contract_hash": {"type": "string", "pattern": "[a-f0-9]{64}"}
      }
    },
    "fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"}
  }
}
