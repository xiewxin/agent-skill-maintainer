{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiewxin.github.io/agent-skill-maintainer/schemas/cleanup-proof.schema.json",
  "title": "Candidate Cleanup Proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action",
    "transaction_id",
    "source_run_id",
    "source_state_sha256",
    "preview_fingerprint",
    "approval_fingerprint",
    "candidate_identity",
    "tree_fingerprint",
    "applied_at",
    "quarantined_before_delete",
    "source_run_unchanged",
    "applied"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "action": {"type": "string", "const": "candidate_cleanup"},
    "transaction_id": {"type": "string", "pattern": "[a-f0-9]{32}"},
    "source_run_id": {"type": "string", "minLength": 1},
    "source_state_sha256": {"type": "string", "pattern": "[a-f0-9]{64}"},
    "preview_fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"},
    "approval_fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"},
    "candidate_identity": {"type": "string", "pattern": "[a-f0-9]{64}"},
    "tree_fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"},
    "applied_at": {"type": "string", "format": "date-time"},
    "quarantined_before_delete": {"type": "boolean", "const": true},
    "source_run_unchanged": {"type": "boolean", "const": true},
    "applied": {"type": "boolean", "const": true}
  }
}
