{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiewxin.github.io/agent-skill-maintainer/schemas/target.schema.json",
  "title": "Confirmed Skill Target",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "targets", "confirmed"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill", "repository"],
        "properties": {
          "skill": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "minLength": 1}
        }
      }
    },
    "confirmed": {"type": "boolean"}
  }
}
