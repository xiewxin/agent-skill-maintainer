{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiewxin.github.io/agent-skill-maintainer/schemas/local-update-approval.schema.json",
  "title": "Local Skill Update Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action",
    "preview_fingerprint",
    "run_id",
    "binding_id",
    "skill",
    "repository",
    "from_version",
    "to_version",
    "release_tag",
    "source_commit",
    "current_fingerprint",
    "target_tree_sha",
    "current_ref",
    "target_ref",
    "canonical_path_fingerprint",
    "install_method",
    "scope",
    "mode",
    "confirmed_at",
    "expires_at",
    "fingerprint"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "action": {"type": "string", "const": "local_update"},
    "preview_fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"},
    "run_id": {"type": "string", "minLength": 1},
    "binding_id": {"type": "string", "minLength": 1},
    "skill": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "from_version": {"type": ["string", "null"]},
    "to_version": {"type": "string", "minLength": 1},
    "release_tag": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "[a-f0-9]{40}"},
    "current_fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"},
    "target_tree_sha": {"type": "string", "pattern": "[a-f0-9]{40}"},
    "current_ref": {"type": ["string", "null"]},
    "target_ref": {"type": "string", "minLength": 1},
    "canonical_path_fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"},
    "install_method": {"type": "string", "const": "npx-skills"},
    "scope": {"type": "string", "const": "global"},
    "mode": {"type": "string", "const": "symlink"},
    "confirmed_at": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "minLength": 1},
    "fingerprint": {"type": "string", "pattern": "[a-f0-9]{64}"}
  }
}
